# Copy this file to .env.local for local development
# Add these to your Vercel project environment variables for production

ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Comma-separated beta access codes. Until BillShield has real payments,
# every AI-powered analysis call (POST /api/analyze, /api/bill-letter)
# requires one of these codes or it is rejected with 401. Keep this secret —
# anyone with a valid code can run analyses that cost you Anthropic credits.
BETA_CODES=change-me-before-deploy

# Soft per-code daily cap enforced by an in-memory counter (see
# api/_lib/auth.js for what this can and cannot guarantee on serverless).
DAILY_CAP_PER_CODE=20

# Required to view /admin (the owner-only stats page). Checked server-side
# in api/admin-stats.js; the endpoint fails closed (401) if this is unset.
# Generate a random value, e.g.: openssl rand -hex 32
ADMIN_STATS_SECRET=change-me-before-deploy
